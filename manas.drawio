<mxfile host="app.diagrams.net">
  <diagram name="0. Home Dashboard" id="page0">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="bg_card" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#dee2e6;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="150" y="100" width="800" height="600" as="geometry" />
        </mxCell>
        <mxCell id="cover_title" value="URL Shortener System Design" style="text;html=1;fontSize=32;fontStyle=1;fontFamily=Helvetica;fontColor=#212529;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="200" y="150" width="700" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cover_subtitle" value="High-Level Architecture &amp; System Requirements Blueprint" style="text;html=1;fontSize=16;fontFamily=Helvetica;fontColor=#6c757d;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="200" y="210" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="btn1" value="1. Functional Requirements" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ff;strokeColor=#74c0fc;fontStyle=1;fontSize=15;fontColor=#1c7ed6;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="320" width="500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="btn2" value="2. Non-Functional Requirements" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6fcf5;strokeColor=#63e6be;fontStyle=1;fontSize=15;fontColor=#0ca678;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="400" width="500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="btn3" value="3. High-Level Architecture (HLD)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3bf;strokeColor=#ffe066;fontStyle=1;fontSize=15;fontColor=#f59f00;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="480" width="500" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="1. Functional Requirements" id="page1">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="fr_title" value="Functional Requirements" style="text;html=1;fontSize=24;fontStyle=1;fontFamily=Helvetica;fontColor=#1c7ed6;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="80" y="40" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="fr_line" style="endArrow=none;html=1;strokeColor=#74c0fc;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="80" y="90" as="sourcePoint" />
            <mxPoint x="1020" y="90" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="fr1" value="URL Shortening&#10;&#10;Users submit long URLs to generate unique, short key aliases." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#74c0fc;align=left;verticalAlign=top;spacing=14;fontSize=13;fontStyle=1;fontColor=#1864ab;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="130" width="430" height="130" as="geometry" />
        </mxCell>
        <mxCell id="fr2" value="URL Redirection&#10;&#10;Accessing a short key redirects users immediately to the original target URL." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#74c0fc;align=left;verticalAlign=top;spacing=14;fontSize=13;fontStyle=1;fontColor=#1864ab;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="590" y="130" width="430" height="130" as="geometry" />
        </mxCell>
        <mxCell id="fr3" value="Custom Alias Selection&#10;&#10;Users can define custom string keys for links if available." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#74c0fc;align=left;verticalAlign=top;spacing=14;fontSize=13;fontStyle=1;fontColor=#1864ab;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="300" width="430" height="130" as="geometry" />
        </mxCell>
        <mxCell id="fr4" value="Link Expiration &amp; Analytics&#10;&#10;Configure link expiration deadlines and track access click counts." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#74c0fc;align=left;verticalAlign=top;spacing=14;fontSize=13;fontStyle=1;fontColor=#1864ab;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="590" y="300" width="430" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="2. Non-Functional Requirements" id="page2">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="nfr_title" value="Non-Functional Requirements" style="text;html=1;fontSize=24;fontStyle=1;fontFamily=Helvetica;fontColor=#0ca678;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="80" y="40" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="nfr_line" style="endArrow=none;html=1;strokeColor=#63e6be;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="80" y="90" as="sourcePoint" />
            <mxPoint x="1020" y="90" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="nfr1" value="High Availability (99.9%)&#10;&#10;Redirection end-points must remain accessible uninterrupted." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#63e6be;align=left;verticalAlign=top;spacing=14;fontSize=13;fontStyle=1;fontColor=#099268;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="130" width="430" height="130" as="geometry" />
        </mxCell>
        <mxCell id="nfr2" value="Ultra-Low Latency (&lt; 20ms)&#10;&#10;Lookup speed must remain under 20ms using distributed caching." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#63e6be;align=left;verticalAlign=top;spacing=14;fontSize=13;fontStyle=1;fontColor=#099268;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="590" y="130" width="430" height="130" as="geometry" />
        </mxCell>
        <mxCell id="nfr3" value="Read-Heavy Scale Architecture&#10;&#10;Designed to support 100:1 Read-to-Write request ratios smoothly." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#63e6be;align=left;verticalAlign=top;spacing=14;fontSize=13;fontStyle=1;fontColor=#099268;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="300" width="430" height="130" as="geometry" />
        </mxCell>
        <mxCell id="nfr4" value="Persistence &amp; Security&#10;&#10;Durable storage with rate-limiting controls to prevent spam abuse." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#63e6be;align=left;verticalAlign=top;spacing=14;fontSize=13;fontStyle=1;fontColor=#099268;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="590" y="300" width="430" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3. System Architecture (HLD)" id="page3">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="URL Shortener — System Architecture Diagram" style="text;html=1;fontSize=24;fontStyle=1;fontFamily=Helvetica;fontColor=#212529;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="150" y="30" width="800" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="High-Level Component Interaction &amp; Request Flow" style="text;html=1;fontSize=14;fontFamily=Helvetica;fontColor=#6c757d;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="150" y="70" width="800" height="20" as="geometry" />
        </mxCell>

        <mxCell id="container" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#dee2e6;strokeWidth=2;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="100" y="110" width="900" height="1220" as="geometry" />
        </mxCell>

        <mxCell id="group_client" value="CLIENT TIER" style="swimlane;whiteSpace=wrap;html=1;fillColor=#e7f5ff;strokeColor=#a5d8ff;fontStyle=1;fontColor=#1971c2;fontSize=12;startSize=25;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="140" width="820" height="130" as="geometry" />
        </mxCell>
        <mxCell id="client_web" value="Web App&#10;(React / Vue)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#74c0fc;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#1864ab;shadow=1;" vertex="1" parent="group_client">
          <mxGeometry x="160" y="45" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="client_mobile" value="Mobile Client&#10;(iOS / Android)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#74c0fc;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#1864ab;shadow=1;" vertex="1" parent="group_client">
          <mxGeometry x="480" y="45" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="flow_1" value="HTTP POST /api/shorten  |  GET /:shortCode" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#1c7ed6;fontStyle=1;fontSize=11;fontColor=#1c7ed6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="group_client" target="node_gateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="node_gateway" value="API Gateway / Web Router&#10;&#10;• HTTPS Termination&#10;• Rate Limiter (Token Bucket)&#10;• Request Validation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6fcf5;strokeColor=#63e6be;strokeWidth=2;fontStyle=0;fontSize=12;fontColor=#099268;align=center;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="320" width="420" height="85" as="geometry" />
        </mxCell>

        <mxCell id="flow_2" value="Sanitized Requests" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#0ca678;fontStyle=1;fontSize=11;fontColor=#0ca678;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="node_gateway" target="group_backend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="group_backend" value="APPLICATION SERVICE TIER" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fff3bf;strokeColor=#ffe066;fontStyle=1;fontColor=#f59f00;fontSize=12;startSize=25;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="450" width="820" height="150" as="geometry" />
        </mxCell>
        <mxCell id="app_shorten" value="URL Shortener&#10;Controller" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fcc419;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#e67700;shadow=1;" vertex="1" parent="group_backend">
          <mxGeometry x="100" y="55" width="160" height="65" as="geometry" />
        </mxCell>
        <mxCell id="app_redirect" value="Redirect&#10;Controller" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fcc419;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#e67700;shadow=1;" vertex="1" parent="group_backend">
          <mxGeometry x="330" y="55" width="160" height="65" as="geometry" />
        </mxCell>
        <mxCell id="app_analytics" value="Analytics / Click&#10;Tracker Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fcc419;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#e67700;shadow=1;" vertex="1" parent="group_backend">
          <mxGeometry x="560" y="55" width="160" height="65" as="geometry" />
        </mxCell>

        <mxCell id="flow_3" value="Encode Request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#f59f00;fontStyle=1;fontSize=11;fontColor=#f59f00;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="group_backend" target="node_generator">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="node_generator" value="Short Code Generator Module&#10;&#10;Base62 Encoder  |  MD5 / Murmur3 Hash  |  Collision Resolver" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3d9fa;strokeColor=#e599f7;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#9c36b5;align=center;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="650" width="480" height="80" as="geometry" />
        </mxCell>

        <mxCell id="flow_cache_read" value="1. Cache Lookup (Read Path)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#ae3ec9;fontStyle=1;fontSize=11;fontColor=#ae3ec9;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="node_generator" target="group_cache">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow_db_write" value="2. Write / Cache Miss" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#ae3ec9;fontStyle=1;fontSize=11;fontColor=#ae3ec9;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="node_generator" target="group_db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="group_cache" value="IN-MEMORY CACHE TIER" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ffe3e3;strokeColor=#ffa8a8;fontStyle=1;fontColor=#e03131;fontSize=12;startSize=25;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="780" width="360" height="160" as="geometry" />
        </mxCell>
        <mxCell id="node_redis" value="Redis Cache Cluster&#10;&#10;• Key: short_code&#10;• Value: original_url&#10;• LRU Eviction Policy&#10;• Sub-10ms Lookup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff8787;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#c92a2a;shadow=1;" vertex="1" parent="group_cache">
          <mxGeometry x="50" y="45" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="group_db" value="PERSISTENT STORAGE TIER" style="swimlane;whiteSpace=wrap;html=1;fillColor=#d3f9d8;strokeColor=#b2f2bb;fontStyle=1;fontColor=#2b8a3e;fontSize=12;startSize=25;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="780" width="360" height="160" as="geometry" />
        </mxCell>
        <mxCell id="node_db" value="Primary Database&#10;(PostgreSQL / MongoDB)&#10;&#10;• Unique Index on short_code&#10;• Long URL Persistent Mapping&#10;• Created Timestamp &amp; Expiry Date" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOpen=1;size=15;fillColor=#ffffff;strokeColor=#69db7c;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#2b8a3e;shadow=1;" vertex="1" parent="group_db">
          <mxGeometry x="60" y="40" width="240" height="100" as="geometry" />
        </mxCell>

        <mxCell id="flow_sync" value="Cache Backfill on Miss" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;dashed=1;strokeColor=#2b8a3e;fontStyle=1;fontSize=10;fontColor=#2b8a3e;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="group_db" target="group_cache">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="legend_box" value="DIAGRAM LEGEND &amp; PROTOCOLS" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f1f3f5;strokeColor=#ced4da;fontStyle=1;fontColor=#495057;fontSize=11;startSize=22;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="990" width="820" height="90" as="geometry" />
        </mxCell>
        <mxCell id="leg1" value="CLIENT → API&#10;JSON over HTTPS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ced4da;fontSize=10;fontStyle=1;fontColor=#495057;" vertex="1" parent="legend_box">
          <mxGeometry x="30" y="35" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="leg2" value="GATEWAY → APP&#10;gRPC / Internal HTTP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ced4da;fontSize=10;fontStyle=1;fontColor=#495057;" vertex="1" parent="legend_box">
          <mxGeometry x="230" y="35" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="leg3" value="APP → CACHE&#10;Redis TCP Protocol" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ced4da;fontSize=10;fontStyle=1;fontColor=#495057;" vertex="1" parent="legend_box">
          <mxGeometry x="430" y="35" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="leg4" value="APP → DB&#10;SQL / Native Driver" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ced4da;fontSize=10;fontStyle=1;fontColor=#495057;" vertex="1" parent="legend_box">
          <mxGeometry x="630" y="35" width="160" height="40" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>